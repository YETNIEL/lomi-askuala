# Copy this file to .env.local for local development.
# NEVER commit a real key. In Vercel, set these in Project Settings → Environment Variables.

# Google Gemini API key (required for AI generation). Free tier: https://aistudio.google.com
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.0-flash if unset.
GEMINI_MODEL=gemini-2.0-flash

# Vercel Postgres (auto-added when you link a Postgres database in Vercel).
# For local dev, run `vercel link` + `vercel env pull .env.local`, or set these manually.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
